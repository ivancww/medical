// Shared medical-and-ci bucket deployment artifact.
// Deploy only through the approved Firebase release process; this PR does not
// deploy production rules. The critical-illness namespace is retained as-is.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.avaAdmin == true;
    }

    function ownsUserScope(userScope) {
      return signedIn()
        && request.auth.token.avaUserScope == userScope;
    }

    function validMedia() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/png',
          'image/jpeg',
          'image/webp'
        ];
    }

    match /critical-illness/official/{planId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validMedia();
      allow delete: if isAdmin();
    }

    match /critical-illness/users/{userScope}/{allPaths=**} {
      allow read: if ownsUserScope(userScope);
      allow create, update: if ownsUserScope(userScope) && validMedia();
      allow delete: if ownsUserScope(userScope);
    }

    // Medical Admin custom-token migration. This is deliberately separate
    // from the Critical Illness namespace in the shared bucket.
    match /medical/official/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validMedia();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
