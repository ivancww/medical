// Shared medical-and-ci bucket deployment artifact.
// Deploy only through the approved Firebase release process; this PR does not
// deploy production rules. The critical-illness namespace is retained as-is.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserScope(userScope) {
      return signedIn()
        && request.auth.token.avaUserScope == userScope;
    }

    function validMedia() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/png',
          'image/jpeg',
          'image/webp'
        ];
    }

    match /critical-illness/official/{planId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if validMedia();
      allow delete: if false;
    }

    match /critical-illness/users/{userScope}/{allPaths=**} {
      allow read: if ownsUserScope(userScope);
      allow create, update: if ownsUserScope(userScope) && validMedia();
      allow delete: if ownsUserScope(userScope);
    }

    // Medical Official product brochures are intentionally public media,
    // matching the current Critical Illness Official-media contract. Keep
    // the grant limited to this brochure namespace; all other Medical paths
    // remain denied by the default rule below.
    match /medical/official/brochures/{allPaths=**} {
      allow read: if true;
      allow create, update: if validMedia();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
